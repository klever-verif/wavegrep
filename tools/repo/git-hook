#!/usr/bin/env bash
set -euo pipefail

hook="$(basename "$0")"
case "$hook" in
    pre-commit)
        [ "$#" -eq 0 ] || {
            printf '%s\n' "usage: $hook" >&2
            exit 2
        }
        ;;
    commit-msg)
        [ "$#" -eq 1 ] || {
            printf '%s\n' "usage: $hook COMMIT_MSG_FILE" >&2
            exit 2
        }
        ;;
    *)
        printf '%s\n' "error: unsupported Git hook: $hook" >&2
        exit 2
        ;;
esac

root="$(git rev-parse --show-toplevel)"
root="$(cd "$root" && pwd -P)"
git_dir="$(git rev-parse --path-format=absolute --absolute-git-dir)"
git_dir="$(cd "$git_dir" && pwd -P)"
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
common_dir="$(cd "$common_dir" && pwd -P)"
workspace="/workspaces/$(basename "$root")"

map_path() {
    local path
    path="$(realpath -m -- "$1")"
    case "$path" in
        "$root") printf '%s\n' "$workspace" ;;
        "$root"/*) printf '%s\n' "$workspace/${path#"$root"/}" ;;
        "$common_dir"|"$common_dir"/*) printf '%s\n' "$path" ;;
        *)
            printf '%s\n' "error: git hook path is outside the mounted worktree and Git common directory: $path" >&2
            return 1
            ;;
    esac
}

index="${GIT_INDEX_FILE-$(git rev-parse --path-format=absolute --git-path index)}"
mapped_root="$(map_path "$root")"
mapped_git_dir="$(map_path "$git_dir")"
mapped_common_dir="$(map_path "$common_dir")"
mapped_index="$(map_path "$index")"
if [ "$hook" = "commit-msg" ]; then
    mapped_message="$(map_path "$1")"
fi
while IFS= read -r name; do
    [[ "$name" == GIT_* ]] && unset "$name"
done < <(compgen -e)

env_args=(
    "GIT_WORK_TREE=$mapped_root"
    "GIT_DIR=$mapped_git_dir"
    "GIT_COMMON_DIR=$mapped_common_dir"
    "GIT_INDEX_FILE=$mapped_index"
)
if [ -n "${SKIP-}" ]; then
    env_args+=("SKIP=$SKIP")
fi

installed_dir="$(cd "$(dirname "$0")" && pwd -P)"
if [ "$hook" = "pre-commit" ]; then
    exec "$installed_dir/dev" --exec-only env "${env_args[@]}" \
        pre-commit run --hook-stage pre-commit
fi
exec "$installed_dir/dev" --exec-only env "${env_args[@]}" \
    pre-commit run --hook-stage commit-msg --commit-msg-filename "$mapped_message"
